# FitFlow Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the actual .env file to git!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (defaults to 8000 if not set)
PORT=8000

# Node environment (development, production, staging)
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=

# Database name (if different from the one in connection string)

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret for authentication (generate a strong random string)
# You can generate one at: https://www.allkeysgenerator.com/Random/Security-Encryption-Key-Generator.aspx
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Session secret for express-session (if you add sessions later)
SESSION_SECRET=your_session_secret_here

# CORS allowed origins (comma-separated)
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000,https://hutizaki.github.io

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================

# Email service (if you add email notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Google OAuth (if you add Google authentication)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Push notifications (if you add push notifications)
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# RATE LIMITING
# =============================================================================

# API rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Never commit this file with real values to git
# 2. Use strong, unique passwords and secrets
# 3. Different environments should have different values
# 4. Restart the server after changing environment variables
# 5. For production, set these in your hosting platform's environment variables
# 6. Keep backups of your environment variables in a secure location
#
