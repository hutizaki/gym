# FitFlow Gym App - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the actual .env file to git!

# =============================================================================
# FRONTEND CONFIGURATION (React + Vite)
# =============================================================================

# API Configuration
# The base URL for your backend API
# Development: http://localhost:8000/api
# Production: https://your-backend-domain.com/api
REACT_APP_API_URL=http://localhost:8000/api

# App Optimization
# Set to 'true' to use the optimized version of the app
# Leave empty or set to 'false' for the standard version
VITE_OPTIMIZED=false

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development server port (optional, defaults to 3000)
# VITE_PORT=3000

# Enable/disable development features
# VITE_DEV_MODE=true

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# GitHub Pages deployment (if using custom domain)
# VITE_BASE_URL=/gym/

# Analytics (if you add analytics later)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# =============================================================================
# OPTIONAL THIRD-PARTY SERVICES
# =============================================================================

# Google Sheets API (if using GoogleSheetsService)
# REACT_APP_GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
# REACT_APP_GOOGLE_SHEETS_SHEET_ID=your_sheet_id_here

# Firebase (if you add Firebase later)
# REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
# REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=your-project-id

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. All React environment variables must start with REACT_APP_ or VITE_
# 2. Never commit sensitive information like API keys to git
# 3. Use different values for development, staging, and production
# 4. Restart your development server after changing environment variables
# 5. For production deployment, set these in your hosting platform's dashboard
#
